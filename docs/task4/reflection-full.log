--- Initial Execution 初稿 ---
def find_primes(n: int) -> list[int]:
    """Return all prime numbers from 1 through n, inclusive."""
    primes = []
    for number in range(2, n + 1):
        is_prime = True
        for divisor in range(2, number):
            if number % divisor == 0:
                is_prime = False
                break
        if is_prime:
            primes.append(number)
    return primes

